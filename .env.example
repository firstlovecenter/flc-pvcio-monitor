# PVCIO Monitor — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to source control.

# ── External auth API (First Love Center) ────────────────────────
VITE_AUTH_API_URL=https://your-auth-api-url

# ── Supabase ─────────────────────────────────────────────────────
# Found in: Supabase Dashboard → Settings → API
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# ── FLC Members GraphQL (church context resolution) ──────────────
# Default: https://dev-api-synago.firstlovecenter.com/graphql
# Override only if you need a different environment.
# VITE_MEMBER_GRAPHQL_URL=https://dev-api-synago.firstlovecenter.com/graphql

# ── Neo4j (leadership / membership graph database) ────────────────
# These are NOT frontend vars — set them as Supabase Edge Function
# secrets via: npx supabase secrets set NEO4J_HTTP_URL=... etc.
#
# NEO4J_HTTP_URL=http://your-neo4j-server:7474
# NEO4J_USER=neo4j
# NEO4J_PASSWORD=your-password
# NEO4J_DATABASE=neo4j   # optional — defaults to "neo4j"
